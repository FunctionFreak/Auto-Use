# User data — lives OUTSIDE the install folder so an uninstall can't destroy it
# (the installer's [UninstallDelete] wipes all of {app}). `python app.py` puts it
# at the repo root; the packaged build uses <home>/autouse_data.
#
# NOTE the trailing /* : ignoring the DIRECTORY itself would make the negation
# below impossible (git can't re-include a path whose parent is excluded), so we
# ignore its CONTENTS and then re-include skills/.
/autouse_data/*

# skills/ IS tracked on purpose — the default .md knowledge files ship with the
# app and get packed into the binary, so the exe can create and populate
# <home>/autouse_data/skills/ on a machine that doesn't have it yet.
!/autouse_data/skills/

# LEGACY chat location (pre-autouse_data) — kept ignored until every checkout has
# migrated, so a contributor who pulls this change before launching the app can't
# commit real chat transcripts still sitting in the package folder.
/Auto_Use/agent_conversation/index.json
/Auto_Use/agent_conversation/chat_*/
automation_grant.json
Auto_Use/ios_connector/paired_devices.json
/Auto_Use/web/target
/Auto_Use/mac/scratchpad
/Auto_Use/web/scratchpad
